# Copy to .env (chmod 600). Never commit .env.
SPREADSHEET_ID=
GOOGLE_APPLICATION_CREDENTIALS=~/.config/claude-usage-forecast/service-account.json
# Written by install.sh
# MACHINE_NAME=my-pc
# CLAUDE_BIN=/home/me/.local/bin/claude
# TMUX_BIN=/usr/bin/tmux
# Optional: state file written by the statusline hook
# USAGE_STATE_FILE=~/.claude/usage-state.json

# Notification (default off). Comma-separated: smtp,webhook,ntfy
NOTIFY_METHODS=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_STARTTLS=1
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# SMTP_TO=
# WEBHOOK_URL=
# ntfy push (phone app "ntfy"): subscribe to the same topic in the app.
# The topic works like a password on ntfy.sh; use a long random name, e.g. the output of
#   python3 -c 'import secrets; print("cuf-" + secrets.token_urlsafe(18))'
# NTFY_TOPIC=
# NTFY_SERVER=https://ntfy.sh
# NTFY_TOKEN=
# NTFY_PRIORITY=4
